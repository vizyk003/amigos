        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|actions|image|imageAlt|tone|pattern|patternWords|align|children|style|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: eyebrow, title, lead, actions, image, imageAlt, tone, pattern, patternWords, align, children, style."
