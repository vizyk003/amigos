        "message": "<CtaBand> pattern must be one of 'type' | 'circle' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|primary|secondary|size|inline|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, children, primary, secondary, size, inline."
      },
